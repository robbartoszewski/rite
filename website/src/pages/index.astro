---
import Site from '../layouts/Site.astro';
import Button from '../components/Button.astro';
import Terminal from '../components/Terminal.astro';
import ProofStrip from '../components/ProofStrip.astro';
import ClaimMap from '../components/ClaimMap.astro';
import StageChain from '../components/StageChain.astro';
import Faq from '../components/Faq.astro';
import InstallCommand from '../components/InstallCommand.astro';
import NotifyStrip from '../components/NotifyStrip.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import {
  REPO, SPEC, PROOF, VERSION, MATURITY, COMMERCIAL_SENTENCE,
  url, formatDate,
} from '../lib/site';

/* The hero terminal: output copied verbatim from the repository's README. */
const TERM_LINES = [
  '<span class="l"><span class="p">$ </span><span class="rt-tok">rite claim backend/src/billing</span> <span class="rt-tok">--worker alpha</span> <span class="rt-tok">--ticket ABC-12</span></span>',
  '<span class="l">claimed 1 path(s) for alpha</span>',
  '<span class="l"> </span>',
  '<span class="l"><span class="p">$ </span><span class="rt-tok">rite claim backend/src/billing</span> <span class="rt-tok">--worker beta</span> <span class="rt-tok">--ticket ABC-19</span></span>',
  '<span class="l err">claim failed: path contention</span>',
  '<span class="l">  <span class="rt-tok">backend/src/billing</span> overlaps <span class="rt-tok">backend/src/billing</span> <span class="rt-tok">(held by alpha)</span></span>',
];

const FAQ = [
  {
    q: 'Is it production-ready?',
    a: `No — <code>${VERSION}</code>, pre-1.0 ${MATURITY.label}. Claim exclusion is measured; the staged pipeline and the independent plan review are enforced in rite&rsquo;s own code. Not there yet: a loop that closes without you starting it, and an all-local fleet fast enough to be the default. <a class="rt-link" href="${url('/what-works')}">What works, what doesn&rsquo;t</a> is the full list.`,
  },
  {
    q: 'Does it work on Linux?',
    a: 'Partly, and the difference matters. rite is built and tested on macOS 26.2. On Linux (tested on Ubuntu 24.04, ARM64) the sandbox is weaker and Workers are not sandboxed by default. Reaching the tmux server, which runs outside the sandbox, is closed on macOS and open on Linux. Windows is not attempted.',
  },
  {
    q: 'Is the sandbox secure?',
    a: 'It bounds files, not capability: outbound network is not restricted, <code>git</code> runs hooks and <code>python -c</code> runs anything. And the sandbox is a Worker thing — treat a Manager as having your own file and network access, because a determined one does.',
  },
  {
    q: 'What does it cost to run?',
    a: 'Your own model usage. rite neither meters nor throttles, so N Workers spend your Claude quota at roughly N times one session&rsquo;s rate, against a quota shared with the Claude apps on a rolling window; Pro exhausts sooner than Max. A Worker that runs out stops where it stands, its claim still held until you release it.',
  },
  {
    q: 'What happens if an agent dies mid-ticket?',
    a: 'Its claim is reported, never released automatically — rite cannot tell a crashed session from one thinking hard, and releasing a path under a live Worker is worse than a stale claim. It names the claim, the holder and the command, and waits for you.',
  },
  {
    q: 'Can I use it on a repository I don’t own?',
    a: 'Yes, through a fork, and the shape is deliberate. You register your fork as the module and give the token write access to the fork and nothing else; the Worker pushes its branch there, and <b>you</b> open the pull request upstream. A diff going to someone else&rsquo;s project should be read by you before its maintainer sees it.',
  },
  {
    q: 'Do I have to sit and watch it?',
    a: 'No — that is the point. You start a run with a budget in sessions and minutes, and it works the board inside that budget. When it needs a decision it asks in Slack and your reply goes back to it. What it will <b>not</b> do is start itself: nothing scheduled ever opens a session, because that would spend your quota with nobody reachable.',
  },
  {
    q: 'Can I run it entirely on my own GPU?',
    a: 'Yes, and be realistic about the speed: an all-local fleet works, at <b>hours per ticket on a single 32&nbsp;GB GPU</b>. The shape that earns its keep today is mixed — Claude plans and reviews, a local GPU does the implementation. An all-local loop that closes on its own is the direction, not something rite ships.',
  },
  { q: 'Do I need this?', a: 'If you run one session at a time, no.' },
  {
    q: 'Is it on PyPI?',
    a: 'No. Install is a <code>curl | sh</code> from a release tag, and needs <code>uv</code> or <code>pipx</code>. The repo documents two slower paths — verify the checksum, or clone and read it — and why you might want them.',
  },
];

/* Latest published post for the one-line "Latest from the blog" row. Hidden
   when there is none, so the row never points at nothing. */
const published = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const latest = published[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'rite',
  applicationCategory: 'DeveloperApplication',
  /* Linux is partial, so it is deliberately left out of structured data. */
  operatingSystem: 'macOS',
  license: 'https://opensource.org/licenses/MIT',
  softwareVersion: VERSION,
  codeRepository: REPO,
  description:
    'Orchestration for fleets of AI coding agents: exclusive file claims, enforced stages, independent-model plan review.',
};
---

<Site
  title="rite — orchestration for fleets of AI coding agents"
  description="Run many AI coding agents on one codebase: exclusive file claims, stages they can't skip, plans reviewed by a different model. Open source, local-first."
  jsonLd={jsonLd}
>
  <main id="main" tabindex="-1">
    <header
      class="rt-container rt-page-head rt-page-head-hero"
      style="display: flex; flex-direction: column; gap: 48px"
    >
      <div class="rt-stack" style="gap: 24px; max-width: var(--measure)">
        <h1 class="rt-title-hero">Tickets in. Draft pull requests out.</h1>
        <p class="rt-lead">
          rite takes a ticket off your board, plans it, gets the plan approved by a <b>different model than wrote it</b> before a line is written, builds it, and opens the
          pull request. You start a run and it works the board for the budget you gave it, asking
          you questions in Slack rather than in a terminal you have to sit and watch.
        </p>
        <p class="rt-lead">
          <b>Your hardware, your engine:</b> cloud Claude, a local GPU, or both at once.
        </p>
        <div class="rt-btn-row">
          <Button href={SPEC} variant="primary" external>Read the spec</Button>
          <Button href={REPO} variant="secondary" external>GitHub</Button>
          <Button href={url('/what-works')} variant="ghost">What works, what doesn&rsquo;t</Button>
        </div>
        <p class="rt-body-sm" style="color: var(--text-muted)">
          <b style="color: var(--text)">Alpha, {VERSION} · MIT.</b> {MATURITY.heroNote}
        </p>
      </div>
      <Terminal
        id="hero-term"
        label="two Workers, one path"
        ariaLabel="Terminal output: two Workers claim one path"
        lines={TERM_LINES}
      />
    </header>

    <ProofStrip />

    <section class="rt-section" aria-labelledby="problem-h">
      <div class="rt-container">
        <div class="rt-section-head">
          <p class="rt-eyebrow">The problem</p>
          <h2 class="rt-h2" id="problem-h">Many agents. One codebase.</h2>
          <p class="rt-lead">
            One coding agent is easy. Six against the same repository, all day, is not.
          </p>
        </div>
        <div class="rt-grid-3">
          <div class="rt-stack">
            <h3 class="rt-h3">They collide.</h3>
            <p>
              Two sessions open the same file and one of them loses — silently, because nothing tells
              either session the other is there.
            </p>
          </div>
          <div class="rt-stack">
            <h3 class="rt-h3">They skip steps.</h3>
            <p>
              A <code>CLAUDE.md</code> that says &ldquo;review before you open a PR&rdquo; is a
              request. Deep into a long session, it is a suggestion.
            </p>
          </div>
          <div class="rt-stack">
            <h3 class="rt-h3">They report success.</h3>
            <p>
              A step that failed comes back as done. Measured, not theoretical: in testing a small
              local model did exactly that, more than once.
            </p>
          </div>
        </div>
        <p class="rt-lead" style="margin: 48px 0 0">
          A prompt can ask for all three. rite <b>enforces</b> them: claims it hands out, stages its
          own code drives, and a review the model being reviewed cannot skip.
        </p>
      </div>
    </section>

    <section class="rt-section" aria-labelledby="how-h" id="how">
      <div class="rt-container">
        <div class="rt-section-head">
          <h2 class="rt-h2" id="how-h">From your board to a pull request.</h2>
        </div>
        <ol class="rt-steps">
          <li class="rt-step">
            <div class="rt-step-text">
              <span class="rt-step-n">01</span>
              <div>
                <h3 class="rt-h3">Your board is the queue.</h3>
                <p>
                  JIRA or GitHub Issues — the board you already run. <code>/refine "export invoices
                  as CSV"</code> drafts a ticket a cold session can start: the paths it touches, a
                  definition of done, and a <code>Verify</code> section naming the command that
                  proves it. It checks the board for a duplicate first, and implements nothing.
                </p>
              </div>
            </div>
          </li>
          <li class="rt-step">
            <div class="rt-step-text">
              <span class="rt-step-n">02</span>
              <div>
                <h3 class="rt-h3">Every agent gets its own ground.</h3>
                <p>
                  <code>rite add worker alpha</code> creates <code>workers/alpha/</code> with its own
                  clone of each module. Before touching anything, a Worker claims its paths, and the
                  second Worker to claim the same path is refused.
                </p>
                <p>
                  On Docker, file locking does not lock — run one Worker there. A claim whose holder
                  died is reported, never released.
                </p>
              </div>
            </div>
            <ClaimMap />
          </li>
          <li class="rt-step">
            <div class="rt-step-text">
              <span class="rt-step-n">03</span>
              <div>
                <h3 class="rt-h3">Seven stages, none of them skippable.</h3>
                <p>
                  Definition, plan, plan review, approach, work, recomposition verify, delivery.
                  rite records where a ticket is, every move goes through one guard, and a stage
                  cannot be entered until the artifact it claims already exists — so none of them
                  can be skipped or reordered. <b>The model that approves a plan is never the model
                  that wrote it</b> — rite checks the duty, the author and the engine, and fails
                  closed when it can&rsquo;t place the author. A rejection goes back to the planner
                  with reasons, and that loop is bounded.
                </p>
                <p>
                  The gates are on rite&rsquo;s stages and the ticket&rsquo;s own agreed check — not
                  on your code quality: no coverage threshold, no lint gate, no opinion on your test
                  strategy.
                </p>
                <p class="rt-body-sm" style="color: var(--text-muted)">
                  Source: <a class="rt-link" href={PROOF.stageTransitions} rel="noopener"
                    >stage.py ↗</a
                  > · <a class="rt-link" href={PROOF.gates} rel="noopener">gates.py ↗</a> · <a
                    class="rt-link"
                    href={PROOF.independence}
                    rel="noopener">the independence check ↗</a
                  >
                </p>
              </div>
            </div>
            <StageChain />
          </li>
          <li class="rt-step">
            <div class="rt-step-text">
              <span class="rt-step-n">04</span>
              <div>
                <h3 class="rt-h3">It comes to you in Slack.</h3>
                <p>
                  Wire up Slack once, and that is where it reaches you: when an agent needs a
                  decision it asks in the thread, and your reply goes back to it. You never attach
                  to a session to answer.
                </p>
                <p>
                  <code>rite status</code> shows every Worker and the paths it holds.
                  <code>rite loop start</code> writes one word, every couple of minutes, for why the
                  run is where it is — everyone busy, files held, schedule closed, nothing waiting,
                  or <b>deadlocked</b>, where it stops and prints exactly what to release.
                </p>
              </div>
            </div>
          </li>
        </ol>
        <p class="rt-note">
          <b>You start the run, and nothing else starts one.</b> <code>rite start lead --sessions 3
          --minutes 90</code> gives a Manager a budget in sessions and minutes, and it works the
          board inside that budget. The run is your own process: Ctrl-C ends it, and so does closing
          the terminal — there is no daemon, and nothing on a schedule ever opens a session. <a
            class="rt-link"
            href={PROOF.unattended}
            rel="noopener">rite refuses that on purpose ↗</a
          >, because it would spend your quota with nobody reachable.
        </p>
      </div>
    </section>

    <section class="rt-section" aria-labelledby="features-h">
      <div class="rt-container">
        <div class="rt-section-head">
          <h2 class="rt-h2" id="features-h">Your hardware. Your engine. Your call.</h2>
        </div>
        <div class="rt-cards">
          <article class="rt-card">
            <h3 class="rt-h3">Mix frontier and local in one fleet.</h3>
            <p>
              The shape that works best today: <b>Claude plans and reviews, a local GPU does the
              implementation.</b> You keep the judgement on a frontier model and push the token-heavy
              work onto hardware you already own.
            </p>
            <p>
              Claude Code, local open-weight models through Goose and Ollama, and Cursor as a Manager
              engine — named integrations rather than a lowest-common-denominator abstraction, on
              purpose. A local model&rsquo;s report is never taken at face value: rite re-checks
              every one in a separate session before the Owner reads it, and says so when the
              checker could not tell.
            </p>
            <p class="rt-caveat rt-card-caveat">
              <Icon name="warn" size={16} /><span
                ><b>Caveat.</b> An all-local fleet runs, but it is slow — hours per ticket on a
                single 32&nbsp;GB GPU. A mixed fleet is one machine and one project root today;
                several Managers across machines is planned for 0.8.0.</span
              >
            </p>
          </article>
          <article class="rt-card">
            <h3 class="rt-h3">Workers run sandboxed on macOS.</h3>
            <p>
              Under Seatbelt, on by default from <code>rite init</code>, so a mistake stays inside
              the project.
            </p>
            <p class="rt-caveat rt-card-caveat">
              <Icon name="warn" size={16} /><span
                ><b>Caveat.</b> It bounds files, not capability — outbound network isn&rsquo;t
                restricted and <code>python -c</code> runs anything. A session you open yourself is
                not sandboxed. On Linux, Workers aren&rsquo;t sandboxed by default.</span
              >
            </p>
          </article>
          <article class="rt-card">
            <h3 class="rt-h3">Secrets don&rsquo;t get committed.</h3>
            <p>
              A scan runs on pre-push and in CI, over full history. Suppressing a finding takes a
              written reason, and there is no global off switch.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="rt-section" aria-labelledby="local-h">
      <div class="rt-container rt-split">
        <div class="rt-stack">
          <p class="rt-eyebrow">Network boundary</p>
          <h2 class="rt-h2" id="local-h">rite runs on your machine.</h2>
          <p>
            rite is a CLI and a set of files in your repository. There is no rite service, no rite
            account and no telemetry — nothing phones home.
          </p>
          <p>
            <b>What leaves your machine is whatever your agents send.</b> On a Claude fleet, that is
            code going to Anthropic, exactly as it does when you use Claude Code yourself. On local
            open-weight models through Ollama, inference stays on your hardware. You can mix the two:
            a Claude Owner with a local secondary Manager is the setup this release is built for, and
            in that setup the Owner&rsquo;s work still goes to Anthropic.
          </p>
          <p>Every edge, by path out:</p>
        </div>
        <div class="rt-table-wrap">
          <table class="rt-table">
            <caption class="rt-sr-only">What leaves your machine, by path out</caption>
            <thead><tr><th scope="col">Path out</th><th scope="col">What goes</th></tr></thead>
            <tbody>
              <tr
                ><th scope="row">rite&rsquo;s own code</th><td
                  >Nothing beyond the rows below. No rite service, no rite account, no telemetry.</td
                ></tr
              >
              <tr
                ><th scope="row">A Claude Owner or Worker</th><td
                  >Code to Anthropic, as with Claude Code itself.</td
                ></tr
              >
              <tr
                ><th scope="row">A local Manager (Goose + Ollama)</th><td
                  >Nothing for inference — it stays on your hardware.</td
                ></tr
              >
              <tr
                ><th scope="row">A Claude or Cursor Manager</th><td
                  >Anything you could send: it has your file and network access, behind a 77-entry
                  allowlist.</td
                ></tr
              >
              <tr
                ><th scope="row">A local (Goose) Manager</th><td
                  >Anything you could send. Goose takes its permission from the environment, not
                  from rite&rsquo;s allowlist.</td
                ></tr
              >
              <tr
                ><th scope="row">A Worker&rsquo;s sandbox</th><td
                  >Outbound network is not restricted.</td
                ></tr
              >
              <tr
                ><th scope="row">Your ticket board</th><td
                  >JIRA or GitHub Issues: the tickets <code>/refine</code> drafts, and its duplicate
                  check.</td
                ></tr
              >
              <tr
                ><th scope="row">git push</th><td>Your branches, to the remote you configured.</td
                ></tr
              >
              <tr
                ><th scope="row">Slack, if you wire it up</th><td
                  >A Manager&rsquo;s questions and replies.</td
                ></tr
              >
              <tr
                ><th scope="row">Claims shared across machines</th><td
                  >Claim and lease state, to the coordination git repository you configure.
                  Implemented, unproven: not yet run on two physical machines over a real network.</td
                ></tr
              >
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="rt-section" aria-labelledby="install-h">
      <div class="rt-container">
        <div class="rt-section-head">
          <h2 class="rt-h2" id="install-h">Install it, or read it first.</h2>
        </div>
        <InstallCommand />
      </div>
    </section>

    <section class="rt-section" aria-labelledby="oss-h">
      <div class="rt-container">
        <div class="rt-stack" style="max-width: var(--measure)">
          <h2 class="rt-h2" id="oss-h">MIT, and the design is public.</h2>
          <p>
            <b>101 numbered decisions</b> in the repository, each with its reasoning. If you want to
            know why something works the way it does, it is written down.
          </p>
          <p>{COMMERCIAL_SENTENCE}</p>
          <div class="rt-btn-row">
            <Button href={url('/licensing')} variant="ghost">Licensing</Button>
          </div>
        </div>
      </div>
    </section>

    {
      latest && (
        <section class="rt-section" aria-label="Latest post" style="padding-bottom: 0">
          <div class="rt-container">
            <p class="rt-latest rt-narrow">
              <span style="color: var(--text-muted)">Latest from the blog</span>
              <a class="rt-link rt-latest-title" href={url(`/blog/${latest.id}`)}>
                {latest.data.title}
              </a>
              <span style="color: var(--text-muted)">
                {latest.data.date && formatDate(latest.data.date)}
              </span>
              <a class="rt-link" href={url('/blog')}>
                All posts
              </a>
            </p>
          </div>
        </section>
      )
    }

    <section class="rt-section" aria-labelledby="faq-h">
      <div class="rt-container">
        <div class="rt-section-head">
          <h2 class="rt-h2" id="faq-h">Common questions.</h2>
        </div>
        <Faq items={FAQ} />
      </div>
    </section>

    <section class="rt-section rt-flame-bg" aria-labelledby="cta-h">
      <img class="rt-flame-art" src={url('/brand/rite-flame.svg')} alt="" width="240" height="546" />
      <div class="rt-container" style="display: flex; flex-direction: column; gap: 48px">
        <div class="rt-stack" style="max-width: var(--measure)">
          <h2 class="rt-h2" id="cta-h">Put your board to work.</h2>
          <p class="rt-lead">
            Six agents on one repository, each holding its own files, none of them able to skip a
            review. MIT, runs on your hardware, and every limit is written down.
          </p>
          <div class="rt-btn-row">
            <Button href={SPEC} variant="primary" external>Read the spec</Button>
            <Button href={REPO} variant="secondary" external>GitHub</Button>
          </div>
        </div>
        <NotifyStrip />
      </div>
    </section>
  </main>
</Site>

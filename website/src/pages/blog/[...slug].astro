---
import Post from '../../layouts/Post.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const isDev = import.meta.env.DEV;
  const all = (await getCollection('blog', (p) => isDev || !p.data.draft)).sort(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
  );
  return all.map((post) => ({
    params: { slug: post.id },
    /* The two latest OTHER posts. Hidden when there is no other. */
    props: { post, more: all.filter((p) => p.id !== post.id).slice(0, 2) },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, more } = Astro.props as Props;
const { Content } = await render(post);
---

<Post post={post} more={more}>
  <Content />
</Post>

---
import { REPO, url } from '../lib/site';
import VersionChip from './VersionChip.astro';

interface Props {
  current?: 'what-works' | 'blog' | 'licensing' | null;
}
const { current = null } = Astro.props;
---
<nav class="rt-nav" aria-label="Main">
  <div class="rt-container rt-nav-inner">
    {/* Two SVG lockups, swapped by theme in CSS. The dark one carries an
        off-white wordmark; the light one the ink wordmark from the logo.
        Both are the real lockup, so there is no text span to keep aligned. */}
    <a class="rt-nav-brand" href={url('/')} aria-label="rite home">
      <img
        class="rt-logo-light"
        src={url('/brand/rite-logo-horizontal.svg')}
        alt="rite"
        width="64"
        height="32"
      />
      <img
        class="rt-logo-dark"
        src={url('/brand/rite-logo-horizontal-dark.svg')}
        alt="rite"
        width="64"
        height="32"
      />
    </a>
    <VersionChip />
    <ul class="rt-nav-links">
      <li>
        <a href={url('/what-works')} aria-current={current === 'what-works' ? 'page' : undefined}
          >What works</a
        >
      </li>
      <li>
        <a href={url('/blog')} aria-current={current === 'blog' ? 'page' : undefined}>Blog</a>
      </li>
      <li>
        <a href={url('/licensing')} aria-current={current === 'licensing' ? 'page' : undefined}
          >Licensing</a
        >
      </li>
      <li><a href={REPO} rel="noopener">GitHub ↗</a></li>
    </ul>
  </div>
</nav>
